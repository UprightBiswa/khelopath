generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  name         String
  age          Int
  sport        String
  state        String
  district     String
  city         String
  createdAt    DateTime      @default(now())
  applications Application[]
  grievances   Grievance[]
}

model Opportunity {
  id               String        @id
  title            String
  sport            String
  state            String
  district         String?
  description      String
  organisationType String
  eligibility      String
  applicationUrl   String?
  status           String        @default("open")
  applications     Application[]
}

model Application {
  id            String             @id
  userId        String
  opportunityId String
  status        String
  submittedAt   DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id])
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id])
  events        ApplicationEvent[]
  grievances    Grievance[]
}

model ApplicationEvent {
  id            String      @id
  applicationId String
  label         String
  description   String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
}

model Grievance {
  id            String           @id
  userId        String
  applicationId String
  category      String
  description   String
  status        String
  assignedTo    String?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id])
  application   Application      @relation(fields: [applicationId], references: [id])
  events        GrievanceEvent[]
}

model GrievanceEvent {
  id          String    @id
  grievanceId String
  label       String
  description String
  createdAt   DateTime  @default(now())
  grievance   Grievance @relation(fields: [grievanceId], references: [id])
}

