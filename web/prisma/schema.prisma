generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  email        String?       @unique
  passwordHash String?
  role         String        @default("athlete")
  name         String
  age          Int
  sport        String
  state        String
  district     String
  city         String
  createdAt    DateTime      @default(now())
  applications Application[]
  grievances   Grievance[]
}

model Sport {
  id            String         @id
  name          String         @unique
  icon          String
  createdAt     DateTime       @default(now())
  opportunities Opportunity[]
  centres       SportsCentre[]
}

model Location {
  id        String         @id
  state     String
  district  String
  city      String
  createdAt DateTime       @default(now())
  centres   SportsCentre[]

  @@unique([state, district, city])
}

model SportsCentre {
  id        String   @id
  name      String
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id])
  state     String
  district  String
  city      String
  latitude  Float
  longitude Float
  type      String
  image     String?
  location  Location @relation(fields: [state, district, city], references: [state, district, city])
}

model Opportunity {
  id               String        @id
  title            String
  sport            String
  sportId          String?
  sportRef         Sport?        @relation(fields: [sportId], references: [id])
  state            String
  district         String?
  city             String?
  description      String
  organisationType String
  eligibility      String
  documents        String[]
  nextSteps        String[]
  image            String?
  matchScore       Int           @default(90)
  applicationUrl   String?
  status           String        @default("open")
  applications     Application[]
  rules            EligibilityRule[]
}

model EligibilityRule {
  id            String      @id
  opportunityId String
  label         String
  rule          String
  plainText     String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}

model Application {
  id            String             @id
  userId        String
  opportunityId String
  status        String
  submittedAt   DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id])
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id])
  events        ApplicationEvent[]
  grievances    Grievance[]
}

model ApplicationEvent {
  id            String      @id
  applicationId String
  label         String
  description   String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
}

model Grievance {
  id            String           @id
  userId        String
  applicationId String
  category      String
  description   String
  status        String
  assignedTo    String?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id])
  application   Application      @relation(fields: [applicationId], references: [id])
  events        GrievanceEvent[]
}

model GrievanceEvent {
  id          String    @id
  grievanceId String
  label       String
  description String
  createdAt   DateTime  @default(now())
  grievance   Grievance @relation(fields: [grievanceId], references: [id])
}
